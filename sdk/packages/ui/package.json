{
	"name": "@cline/ui",
	"version": "0.2.0-next.9",
	"description": "Shared Zeck web theme and reusable agent UI components",
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/cline",
		"directory": "sdk/packages/ui"
	},
	"private": false,
	"internal": true,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"build": "bun scripts/generate-theme.ts --check && bun tsc -p tsconfig.build.json && bun scripts/generate-theme.ts",
		"typecheck": "bun tsc -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"@cline/shared": "workspace:*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"lucide-react": "^0.479.0"
	}
}
